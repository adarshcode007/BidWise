flowchart TD
    %% Base styling
    classDef agent fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef state fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef storage fill:#f3e8ff,stroke:#9333ea,stroke-width:2px,color:#6b21a8;
    classDef action fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#15803d;

    subgraph InputData ["Input Corpus & Proposals"]
        TenderDoc["data/tender.txt<br/>(Tender Specifications)"]:::storage
        Bids["data/bids/bid_A..D.txt<br/>(Vendor Submissions)"]:::storage
        Rubric["data/rubric.json<br/>(Scoring Rubric)"]:::storage
    end

    subgraph Phase1 ["1. Criteria Retrieval (RAG)"]
        CritAgent["Criteria Agent<br/>(RAG via TF-IDF)"]:::agent
        TenderDoc -->|"Clause Extraction"| CritAgent
    end

    subgraph SharedContext ["Central Shared State & Audit"]
        Scorecard[("Shared Scorecard<br/>(asyncio.Lock Protected)")]:::state
        RunLog[("Append-Only Audit Log<br/>logs/run_log.jsonl")]:::state
    end

    CritAgent -->|"Populate Criteria & Weights"| Scorecard
    CritAgent -.->|"Log Event"| RunLog

    subgraph FanOut ["2. Parallel Scoring Fan-Out (asyncio.gather)"]
        direction TB
        subgraph ScorerA ["Bid A Execution"]
            CompA["Compliance Agent"]:::agent
            TechA["Technical Scorer"]:::agent
            CommA["Commercial Scorer"]:::agent
            CompA --> TechA --> CommA
        end
        subgraph ScorerB ["Bid B Execution"]
            CompB["Compliance Agent"]:::agent
            TechB["Technical Scorer"]:::agent
            CommB["Commercial Scorer"]:::agent
            CompB --> TechB --> CommB
        end
        subgraph ScorerC ["Bid C Execution (Disqualified)"]
            CompC["Compliance Agent<br/>(Missing EMD Receipt)"]:::agent
        end
        subgraph ScorerD ["Bid D Execution"]
            CompD["Compliance Agent"]:::agent
            TechD["Technical Scorer"]:::agent
            CommD["Commercial Scorer"]:::agent
            CompD --> TechD --> CommD
        end
    end

    Scorecard -->|"Dispatch Bids"| FanOut
    Bids --> FanOut
    Rubric --> FanOut

    FanOut -->|"Write Criterion Slices"| Scorecard
    FanOut -.->|"Audit Tool Calls"| RunLog

    subgraph FanIn ["3. Fan-In Aggregation & Ranking"]
        AwardMgr["Award Manager<br/>(Apply Weights & Filter Disqualified)"]:::agent
    end

    Scorecard -->|"Read Complete Slices"| AwardMgr
    AwardMgr -->|"Update Weighted Totals & Initial Rank"| Scorecard

    subgraph Decision ["4. Tie-Break Resolution"]
        TieCheck{"Score Margin<br/>&le; 2.0 Points?"}:::action
        TieAgent["Tie-Break Agent<br/>(Secondary: Delivery Days)"]:::agent
    end

    AwardMgr --> TieCheck
    TieCheck -- "Yes" --> TieAgent
    TieAgent -->|"Re-rank: Shorter Delivery Wins"| Scorecard
    TieCheck -- "No" --> AwardFinal

    subgraph Finalization ["5. Justification & Output Generation"]
        AwardFinal["Award Manager<br/>(Final Award & Weighted Justification)"]:::agent
        Outputs["Deliverables<br/>output/report.md & output/scorecard.json"]:::storage
    end

    TieAgent --> AwardFinal
    AwardFinal -->|"Final Winner & Justification"| Scorecard
    AwardFinal --> Outputs
